# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Environment files (secrets). Keep the example template tracked.
.env
.env.*
!.env.example

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
client/node_modules/*
server/node_modules/*
worker/node_modules/*

# Wrangler's local build cache for the relay worker (worker/).
worker/.wrangler

# yt-dlp session tokens. Written by every run, different on every machine, and it
# keeps coming up as a modified file while it stays tracked - hence the file is
# untracked as well as ignored.
server/cookies.txt

# The yt-dlp binary scripts/setup-yt-dlp.js fetches on a non-Windows host. It is
# platform-specific and replaced by the build, so it is never committed - the
# Windows yt-dlp.exe stays tracked because it is the one already in the repo.
server/yt-dlp

# The PO-token provider scripts/setup-pot-provider.js fetches, and the yt-dlp
# plugin that talks to it. Same reasoning as yt-dlp itself: platform-specific,
# ~50 MB, and put in place by the build.
server/bgutil-pot
server/bgutil-pot.exe
server/plugins/

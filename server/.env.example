# Copy this file to .env and fill in real values.
# .env is gitignored and must never be committed.

# YouTube Data API v3 key used by /api/playlist and /api/video.
YOUTUBE_API_KEY=

# Port the Express server listens on (defaults to 3000).
PORT=3000

# Origins a browser may call this server from, comma-separated. The local
# Vite dev servers are always allowed; a deployed client has to be listed,
# e.g. ALLOWED_ORIGINS=https://tubeko.vercel.app - without it the deployed
# page would reach the server but be refused the response.
ALLOWED_ORIGINS=

# Port the PO-token provider listens on (loopback only, defaults to 4416).
# Only change it if something else on the host already holds that port.
POT_SERVER_PORT=

# Which YouTube player client yt-dlp asks for. Left empty, the server picks
# mweb when it has no cookies (the client the PO token is meant for) and yt-dlp's
# own default once cookies are configured. Clients get blocked one at a time, so
# this is the switch to reach for when downloads start failing again.
YTDLP_PLAYER_CLIENT=

# Log the detail behind a refused request - --verbose instead of --no-warnings.
# Set it to 1 temporarily when YouTube rejects the server; the token plugin
# reports its own failures as warnings, and --no-warnings hides exactly those.
YTDLP_VERBOSE=

# A logged-in YouTube session, as a Netscape cookie export. This is what clears
# "Sign in to confirm you're not a bot", which YouTube answers with from a
# datacenter IP - and unlike a PO token it also brings back the full range of
# resolutions. Base64 is the safer form for a host that stores secrets in a
# dashboard: no tabs, no newlines.
#
# Export the cookies from a throwaway account, in a private/incognito window:
# log in to youtube.com, open https://www.youtube.com/robots.txt in that same
# tab, export youtube.com cookies with a "cookies.txt" extension, then close the
# window so the session is never opened again (an open tab rotates the cookies,
# which invalidates the export). Base64 it with:
#   node -e "console.log(require('fs').readFileSync('cookies.txt').toString('base64'))"
#
# YouTube can throttle or ban an account used this way, so use a throwaway one.
# Prefer cookies.txt next to server.js for local development - both are read.
YOUTUBE_COOKIES_B64=
YOUTUBE_COOKIES=

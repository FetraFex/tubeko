# Copy this file to .env and fill in real values.
# .env is gitignored and must never be committed.

# YouTube Data API v3 key used by /api/playlist and /api/video.
YOUTUBE_API_KEY=

# Port the Express server listens on (defaults to 3000).
PORT=3000

# Origins a browser may call this server from, comma-separated. The local
# Vite dev servers are always allowed; a deployed client has to be listed,
# e.g. ALLOWED_ORIGINS=https://tubeko.vercel.app - without it the deployed
# page would reach the server but be refused the response.
ALLOWED_ORIGINS=
